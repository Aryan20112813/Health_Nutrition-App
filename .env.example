# GEMINI_API_KEY: Required for Gemini AI API calls (injected at runtime)
GEMINI_API_KEY=""

# APP_URL: Injected at runtime
APP_URL=""

# MongoDB Database Connection String (e.g. MongoDB Atlas cluster URI)
MONGODB_URI=""

# Authentication Secrets (Generated via Node crypto randomBytes(64).toString('hex'))
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# Server & Client Configuration
NODE_ENV="development"
PORT="3000"
CLIENT_URL="http://localhost:3000"
